{
  "name": "user-prompt-optimizer",
  "version": "0.3.0",
  "description": "Obsidian plugin: refine a selected prompt with an LLM. Supports template-driven structured optimization and template-free light polishing.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "prompt-engineering",
    "prompt-optimization",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.11.4",
    "typescript": "^5.4.0"
  }
}
